{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excalidraw Desktop",
  "version": "0.3.0",
  "identifier": "dev.rafa.excalidraw-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Excalidraw Desktop",
        "width": 1400,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "category": "Graphics",
    "shortDescription": "Local-first Excalidraw",
    "longDescription": "A fully offline, themeable Excalidraw drawing application for Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    }
  }
}
