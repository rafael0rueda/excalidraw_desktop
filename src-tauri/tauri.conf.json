{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excalidraw Desktop",
  "version": "0.4.0",
  "identifier": "dev.rafa.excalidraw-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Excalidraw Desktop",
        "width": 1400,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "deb"
    ],
    "category": "Graphics and Design",
    "publisher": "rafa",
    "homepage": "https://github.com/rafael0rueda/excalidraw_desktop",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 rafa",
    "shortDescription": "Local-first Excalidraw",
    "longDescription": "A fully offline, themeable Excalidraw drawing application for Linux.",
    "fileAssociations": [
      {
        "ext": [
          "excalidraw"
        ],
        "name": "Excalidraw drawing",
        "description": "Excalidraw drawing",
        "mimeType": "application/vnd.excalidraw+json",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "rpm": {
        "files": {
          "/usr/share/licenses/excalidraw-desktop/LICENSE": "../LICENSE",
          "/usr/share/mime/packages/excalidraw-desktop.xml": "../packaging/excalidraw-desktop.xml"
        },
        "postInstallScript": "../packaging/post-install.sh",
        "postRemoveScript": "../packaging/post-remove.sh",
        "desktopTemplate": "../packaging/excalidraw-desktop.desktop.hbs"
      },
      "deb": {
        "files": {
          "/usr/share/doc/excalidraw-desktop/copyright": "../LICENSE",
          "/usr/share/mime/packages/excalidraw-desktop.xml": "../packaging/excalidraw-desktop.xml"
        },
        "postInstallScript": "../packaging/post-install.sh",
        "postRemoveScript": "../packaging/post-remove.sh",
        "desktopTemplate": "../packaging/excalidraw-desktop.desktop.hbs"
      }
    }
  }
}
